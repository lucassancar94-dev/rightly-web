# ─────────────────────────────────────────────────────────────
# Aura Sales Coach – Umgebungsvariablen
# Kopieren nach .env.local und Werte eintragen.
# ALLE Schlüssel bleiben ausschließlich auf dem Server.
# Niemals mit NEXT_PUBLIC_ prefixen!
# ─────────────────────────────────────────────────────────────

# OpenAI (Pflicht für echte KI-Antworten; ohne Schlüssel läuft
# die App im regelbasierten Demo-Modus)
OPENAI_API_KEY=
# Modell für Live-Coach und KI-Chat (schnell + günstig empfohlen)
OPENAI_MODEL=gpt-4o-mini
# Modell für Spracheingabe (Transkription)
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Zugangscode für Verkäufer (schützt die App + Ihr OpenAI-Budget).
# Leer lassen = kein Zugangsschutz (nur für lokale Entwicklung!)
APP_ACCESS_CODE=

# Passwort für den Admin-Bereich (/admin) zur Produktpflege
ADMIN_PASSWORD=

# Geheimnis zum Signieren der Login-Cookies (mind. 32 zufällige Zeichen)
# z. B. erzeugen mit: openssl rand -hex 32
SESSION_SECRET=

# Supabase (optional – ohne Supabase wird data/products.json verwendet)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
